n-1024x1024.jpg 1024w, https:\/\/cannabisconnection.ca\/wp-content\/uploads\/2025\/01\/472764945_122130310160559465_222687003096753645_n-150x150.jpg 150w, https:\/\/cannabisconnection.ca\/wp-content\/uploads\/2025\/01\/472764945_122130310160559465_222687003096753645_n-768x768.jpg 768w\" sizes=\"(max-width: 1440px) 100vw, 1440px\" \/><\/a>\n\t\t\t<\/dt><\/dl><br style=\"clear: both\" \/>\n\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-699389ce elementor-widget elementor-widget-text-editor\" data-id=\"699389ce\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\n<p>\ud83c\udf89 <strong>Congratulations to Our Grand Opening Giveaway Winners!<\/strong> \ud83c\udf89<\/p>\n\n\n\n<p>A big shoutout to all the amazing winners of our <strong>Cannabis Connection Chilliwack Grand Opening Giveaway<\/strong>! \ud83c\udf1f Thank you for joining the celebration and showing your support for our new location. Here are the lucky winners and their prizes:<\/p>\n\n\n\n<ul class=\"wp-block-list\">\n<li><strong>Jeff<\/strong>: Mini Fridge<\/li>\n\n\n\n<li><strong>Devin Noel<\/strong>: PS5<\/li>\n\n\n\n<li><strong>Jolynn Noel<\/strong>: Portable BBQ<\/li>\n\n\n\n<li><strong>Madison S<\/strong>: Chocolate Gift Basket<\/li>\n\n\n\n<li><strong>Danielle Campbell<\/strong>: Bluetooth Speaker<\/li>\n\n\n\n<li><strong>Tatum Stevens<\/strong>: Apple Watch<\/li>\n\n\n\n<li><strong>Xavier Hicks<\/strong>: Canucks Tickets<\/li>\n\n\n\n<li><strong>Anthony Couts<\/strong>: Silicone Bong<\/li>\n\n\n\n<li><strong>Nick White<\/strong>: Glass Bong<\/li>\n<\/ul>\n\n\n\n<p>We\u2019re thrilled to have you as part of our community and look forward to seeing you all in-store soon! \ud83c\udf3f Whether you\u2019re here to browse our <strong>interactive cannabis shopping experience<\/strong>, check out over <strong>100+ strains of flower<\/strong>, or discover new cannabis products, we\u2019re here to provide the best experience possible.<\/p>\n\n\n\n<p>Thank you for making our grand opening such a success! \ud83c\udf89 Stay tuned for more exciting events and giveaways at <strong>Cannabis Connection Chilliwack<\/strong>.<\/p>\n\n\n\n<p>#GrandOpening #ContestWinners #ChilliwackCannabis #CannabisConnection #ShopLocal \ud83c\udf3f<\/p>\n\n\n\n<p><\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>\ud83c\udf89 Congratulations to Our Grand Opening Giveaway Winners! \ud83c\udf89 A big shoutout to all the amazing winners of our Cannabis Connection Chilliwack Grand Opening Giveaway! \ud83c\udf1f Thank you for joining the celebration and showing your support for our new location. Here are the lucky winners and their prizes: We\u2019re thrilled to have you as part&#8230;<\/p>\n","protected":false},"author":1,"featured_media":7495,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_coblocks_attr":"","_coblocks_dimensions":"","_coblocks_responsive_height":"","_coblocks_accordion_ie_support":"","footnotes":"","_links_to":"","_links_to_target":""},"categories":[45],"tags":[],"class_list":["post-7491","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-contests"],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v27.1.1 - https:\/\/yoast.com\/product\/yoast-seo-wordpress\/ -->\n<title>Congratulations to Our Grand Opening Giveaway Winners! - Cannabis Connection - Licensed Cannabis Store<\/title>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/cannabisconnection.ca\/general\/contests\/congratulations-to-our-grand-opening-giveaway-winners\/\" \/>\n<meta property=\"og:locale\" content=\